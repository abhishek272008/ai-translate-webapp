:root {
  --primary: #172554;
  --primary-soft: #1d3a7a;
  --secondary: #2563eb;
  --accent: #06b6d4;
  --bg: #f8fafc;
  --white: #ffffff;
  --text: #1e293b;
  --muted: #64748b;
  --surface: rgba(255, 255, 255, 0.7);
  --shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
  --border: rgba(148, 163, 184, 0.2);
  --radius-lg: 28px;
  --radius-md: 18px;
  --radius-sm: 12px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(6, 182, 212, 0.12), transparent 30%),
    radial-gradient(circle at top right, rgba(37, 99, 235, 0.12), transparent 25%),
    var(--bg);
  color: var(--text);
}

a {
  text-decoration: none;
  color: inherit;
}

button,
select,
textarea {
  font: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
}

.page-shell {
  min-height: 100vh;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 40;
  backdrop-filter: blur(14px);
  background: rgba(248, 250, 252, 0.8);
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 84px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 1.2rem;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: var(--white);
  box-shadow: var(--shadow);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 22px;
}

.nav-links a {
  position: relative;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text);
  transition: color 0.2s ease;
}

.nav-links a::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8px;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, var(--secondary), var(--accent));
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 0.2s ease;
}

.nav-links a:hover,
.nav-links a:focus-visible {
  color: var(--secondary);
}

.nav-links a:hover::after,
.nav-links a:focus-visible::after {
  transform: scaleX(1);
}

.nav-button,
.primary-button,
.secondary-button,
.footer-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border-radius: 999px;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.nav-button,
.primary-button {
  padding: 0.9rem 1.5rem;
  background: linear-gradient(135deg, var(--secondary), var(--primary));
  color: var(--white);
  box-shadow: 0 18px 35px rgba(37, 99, 235, 0.34);
}

.secondary-button,
.footer-button {
  padding: 0.9rem 1.5rem;
  border: 1px solid rgba(37, 99, 235, 0.18);
  background: rgba(255, 255, 255, 0.6);
  color: var(--primary);
}

.nav-button:hover,
.primary-button:hover,
.secondary-button:hover,
.footer-button:hover {
  transform: translateY(-2px);
}

.hero {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 48px;
  padding: 72px 0 46px;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 1.02;
  letter-spacing: -0.07em;
  max-width: 620px;
  color: var(--primary);
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0.7rem 1.1rem;
  border-radius: 999px;
  background: rgba(6, 182, 212, 0.12);
  color: var(--primary);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.eyebrow-inline {
  margin-bottom: 16px;
}

.hero-copy p {
  max-width: 650px;
  margin: 1.25rem 0 0;
  font-size: 1.08rem;
  line-height: 1.8;
  color: var(--muted);
}

.hero-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 2rem;
}

.feature-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 2rem;
}

.feature-pill {
  display: inline-flex;
  align-items: center;
  padding: 0.7rem 1rem;
  border-radius: 999px;
  border: 1px solid rgba(25, 88, 178, 0.14);
  background: rgba(255, 255, 255, 0.8);
  color: var(--text);
  font-size: 0.88rem;
  font-weight: 600;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
}

.hero-visual {
  display: flex;
  justify-content: center;
}

.visual-panel {
  position: relative;
  width: min(520px, 100%);
  min-height: 510px;
  border-radius: 36px;
  background: linear-gradient(180deg, rgba(23, 37, 84, 0.98), rgba(13, 24, 56, 0.96));
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 30px 70px rgba(23, 37, 84, 0.25);
  overflow: hidden;
}

.visual-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.18), rgba(37, 99, 235, 0.06));
}

.bubble {
  position: absolute;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120px;
  padding: 0.9rem 1.15rem;
  border-radius: 18px;
  font-weight: 700;
  color: var(--white);
  box-shadow: 0 20px 32px rgba(15, 23, 42, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(10px);
  animation: float 6s ease-in-out infinite;
}

.bubble-en {
  top: 58px;
  left: 44px;
  background: rgba(37, 99, 235, 0.68);
}

.bubble-hi {
  top: 148px;
  right: 52px;
  background: rgba(6, 182, 212, 0.7);
  animation-delay: 1s;
}

.bubble-kn {
  bottom: 56px;
  left: 54px;
  background: rgba(23, 37, 84, 0.85);
  animation-delay: 2s;
}

.neural-core {
  position: absolute;
  inset: 50% auto auto 50%;
  transform: translate(-50%, -50%);
  width: 160px;
  height: 160px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(37, 99, 235, 0.2));
  border: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 18px 44px rgba(6, 182, 212, 0.24);
}

.core-ring {
  position: absolute;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  animation: pulse 4s ease-in-out infinite;
}

.ring-one {
  inset: 14px;
}

.ring-two {
  inset: 30px;
  animation-delay: 0.7s;
}

.ring-three {
  inset: 46px;
  animation-delay: 1.2s;
}

.core-icon {
  display: grid;
  place-items: center;
  width: 68px;
  height: 68px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.38), rgba(255, 255, 255, 0.12));
  color: var(--white);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.network {
  position: absolute;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  box-shadow: inset 0 0 12px rgba(255, 255, 255, 0.08);
}

.network-1 {
  left: 18%;
  top: 28%;
  width: 160px;
  height: 30px;
  transform: rotate(20deg);
}

.network-2 {
  right: 18%;
  top: 36%;
  width: 170px;
  height: 32px;
  transform: rotate(-15deg);
}

.network-3 {
  left: 34%;
  bottom: 24%;
  width: 180px;
  height: 30px;
  transform: rotate(15deg);
}

.section {
  padding: 96px 0;
}

.alt-bg {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(233, 244, 255, 0.7));
}

.section-header {
  max-width: 780px;
  margin: 0 auto 48px;
  text-align: center;
}

.section-header h2 {
  margin: 0;
  font-size: clamp(2.2rem, 4vw, 3.3rem);
  line-height: 1.1;
  letter-spacing: -0.06em;
  color: var(--primary);
}

.section-header p {
  margin: 1rem auto 0;
  max-width: 760px;
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--muted);
}

.card-grid {
  display: grid;
  gap: 24px;
}

.four-columns {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.info-card,
.feature-card,
.showcase-card,
.process-step,
.translator-card,
.stat-box {
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.info-card,
.feature-card,
.process-step {
  padding: 1.8rem 1.5rem;
}

.icon-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(6, 182, 212, 0.12));
  color: var(--secondary);
}

.info-card h3,
.feature-card h3,
.process-step h3,
.accent-card h3 {
  margin: 1.2rem 0 0.7rem;
  font-size: 1.3rem;
  letter-spacing: -0.04em;
  color: var(--primary);
}

.info-card p,
.feature-card p,
.process-step p,
.accent-card p {
  margin: 0;
  line-height: 1.7;
  color: var(--muted);
}

.feature-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(135deg, var(--secondary), var(--accent));
  color: var(--white);
  font-weight: 800;
  box-shadow: 0 18px 30px rgba(37, 99, 235, 0.3);
}

.stacked-showcase {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 24px;
}

.showcase-card {
  padding: 2rem;
}

.mini-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 0.5rem;
}

.mini-list span {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
  color: var(--primary);
}

.accent-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: linear-gradient(135deg, rgba(23, 37, 84, 0.96), rgba(37, 99, 235, 0.9));
  color: var(--white);
  padding: 2rem;
}

.accent-card h3,
.accent-card p {
  color: var(--white);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.stat-box {
  padding: 1.6rem 1.2rem;
  text-align: center;
}

.stat-box strong {
  display: block;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  letter-spacing: -0.06em;
  color: var(--primary);
}

.stat-box span {
  display: inline-block;
  margin-top: 0.4rem;
  color: var(--muted);
  font-weight: 600;
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.process-step span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(6, 182, 212, 0.14));
  color: var(--secondary);
  font-weight: 800;
}

.translator-wrap {
  padding-bottom: 88px;
}

.translator-card {
  padding: 2rem;
  max-width: 1100px;
  margin: 0 auto;
}

.translator-toolbar {
  display: flex;
  align-items: end;
  gap: 16px;
  flex-wrap: wrap;
}

.lang-select-wrap {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10px;
}

.lang-select-wrap label {
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--muted);
}

.lang-select-wrap select {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 14px;
  background: rgba(248, 250, 252, 0.9);
  color: var(--text);
  padding: 0.95rem 1rem;
}

.swap-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border: 1px solid rgba(37, 99, 235, 0.18);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.8);
  color: var(--primary);
  cursor: pointer;
}

.quick-prompts {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 1.5rem;
}

.quick-prompts button {
  border: 1px solid rgba(148, 163, 184, 0.24);
  background: rgba(255, 255, 255, 0.7);
  color: var(--text);
  border-radius: 999px;
  padding: 0.7rem 1rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.quick-prompts button:hover {
  border-color: rgba(37, 99, 235, 0.3);
  color: var(--secondary);
}

.translator-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 1.5rem;
}

.translation-box {
  min-height: 250px;
  border-radius: 22px;
  background: rgba(248, 250, 252, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  overflow: hidden;
}

.box-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.2rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  color: var(--primary);
  font-weight: 700;
}

.translation-box textarea {
  width: 100%;
  min-height: 200px;
  padding: 1rem 1.2rem 1.5rem;
  border: 0;
  background: transparent;
  resize: vertical;
  color: var(--text);
  line-height: 1.7;
  font-size: 1rem;
}

.translation-box textarea:focus {
  outline: none;
}

.output-box {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.06), rgba(6, 182, 212, 0.08));
}

.footer {
  padding: 18px 0 30px;
  background: rgba(15, 23, 42, 0.98);
  color: rgba(255, 255, 255, 0.85);
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.footer-brand {
  color: var(--white);
}

.footer p {
  margin: 0.8rem 0 0;
  color: rgba(255, 255, 255, 0.75);
}

.footer-links {
  display: flex;
  align-items: center;
  gap: 26px;
  flex-wrap: wrap;
}

.footer-links a {
  color: rgba(255, 255, 255, 0.8);
}

.contact-cta {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.contact-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0.7rem 1rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.8);
  font-size: 0.82rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-10px);
  }
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}

.menu-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.8);
  padding: 0.7rem 0.6rem;
  cursor: pointer;
}

.menu-toggle span {
  width: 100%;
  height: 2px;
  background: var(--text);
  border-radius: 999px;
}

@media (max-width: 980px) {
  .hero,
  .stacked-showcase,
  .process-grid,
  .four-columns,
  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .hero {
    padding-top: 54px;
  }

  .nav-links {
    position: absolute;
    top: calc(100% + 10px);
    left: 16px;
    right: 16px;
    display: none;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.2rem;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 22px;
    box-shadow: var(--shadow);
  }

  .nav-links.open {
    display: flex;
  }

  .menu-toggle {
    display: flex;
  }
}

@media (max-width: 720px) {
  .hero,
  .stacked-showcase,
  .process-grid,
  .four-columns,
  .stats-grid,
  .translator-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    gap: 32px;
  }

  .navbar {
    min-height: 72px;
  }

  .hero-copy h1 {
    font-size: 2.7rem;
  }

  .feature-pills,
  .hero-actions,
  .footer-inner,
  .contact-cta {
    width: 100%;
  }

  .translator-card {
    padding: 1.25rem;
  }

  .translator-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .swap-button {
    align-self: center;
  }
}
